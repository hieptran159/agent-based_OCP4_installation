apiVersion: v1alpha1
kind: AgentConfig
metadata:
  name: hp
rendezvousIP: 198.18.2.21
hosts:
  - hostname: master01.hp.hipe.id.vn
    interfaces:
     - name: ens192
       macAddress: 00:50:56:87:94:a1
    networkConfig:
      interfaces:
        - name: ens192
          type: ethernet
          state: up
          mac-address: 00:50:56:87:94:a1
          ipv4:
            enabled: true
            address:
              - ip: 198.18.2.21
                prefix-length: 24
            dhcp: false
      dns-resolver:
        config:
          server:
            - 198.18.2.225 
      routes:
        config:
          - destination: 0.0.0.0/0
            next-hop-address: 198.18.2.1
            next-hop-interface: ens192
  - hostname: master02.hp.hipe.id.vn
    interfaces:
     - name: ens192
