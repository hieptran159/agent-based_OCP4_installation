apiVersion: v1
baseDomain: hipe.id.vn
compute:
- architecture: amd64
  hyperthreading: Enabled
  name: worker
  replicas: 3
controlPlane:
  architecture: amd64
  hyperthreading: Enabled
  name: master
  replicas: 3
metadata:
  name: hp
networking:
  clusterNetwork:
  - cidr: 10.16.0.0/14
    hostPrefix: 23
  machineNetwork:
  - cidr: 198.18.2.0/24
  networkType: OVNKubernetes
  serviceNetwork:
  - 172.30.0.0/16
platform:
  baremetal:
    provisioningNetwork: Disabled
    hosts:
      - name: worker01
        role: worker
        bootMACAddress: 00:50:56:87:94:b1
      - name: worker02
        role: worker
        bootMACAddress: 00:50:56:87:94:b2
      - name: worker03
        role: worker
        bootMACAddress: 00:50:56:87:94:b3
      - name: master01
        role: master
        bootMACAddress: 00:50:56:87:94:a1
      - name: master02
        role: master
        bootMACAddress: 00:50:56:87:94:a2
      - name: master03
        role: master
        bootMACAddress: 00:50:56:87:94:a3
    apiVIPs: ["198.18.2.12"]
    ingressVIPs: ["198.18.2.11"]
